{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "client: start",
            "type": "shell",
            "command": "npm --prefix src/frontend/client run start",
            "isBackground": true,
            "problemMatcher": {
                "owner": "angular",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "(ng serve|Angular Live Development Server)",
                    "endsPattern": "(Application bundle generation complete|Local:)"
                }
            }
        },
        // 仓库里没有 .sln，构建/调试一律按项目走；
        // 需要长时间热重载时，在终端里跑：dotnet watch run --project <csproj>
        {
            "label": "build: user-service",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/backend/services/user-service/src/User.Api/user.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build: travel-service",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/backend/services/travel-history/src/Travel.Api/travel.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build: identity-service",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/backend/services/identity-service/src/Identity.Api/identity.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}