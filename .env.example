# Copy to .env for local Docker Compose use. Never commit the copy.
DB_PASSWORD=replace-with-a-local-password
JWT_KEY=replace-with-a-long-random-signing-key
DEMO_USER_PASSWORD=replace-with-a-development-only-password
# Grafana 管理员口令（本地观测栈）。原先提交的默认值是 admin/admin，已移除：
# 缺失时 compose 会直接报错，避免默认凭据被带到任何共享环境。
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password
# identity-service 的独立数据库角色口令（ADR-0020：它只有 Users 的 SELECT 权限）。
# 必须与 DB_PASSWORD 不同 —— 否则最小权限角色形同虚设（泄露一个口令就换回 appuser 身份）。
# 首次准备顺序（Users 表要先存在）：
#   docker compose up -d db server
#   pwsh -File scripts/provision-identity-db-role.ps1
IDENTITY_DB_PASSWORD=replace-with-a-different-local-password