# 统一换行符策略：仓库内一律存 LF，检出时按平台/默认规则处理
* text=auto

# 明确源码类文件为文本（存 LF）
*.cs text
*.csproj text
*.slnx text
*.ts text
*.js text
*.json text
*.html text
*.scss text
*.css text
*.md text
*.yml text
*.yaml text
*.sql text

# Windows 专属脚本保留 CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell 脚本必须 LF
*.sh text eol=lf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
