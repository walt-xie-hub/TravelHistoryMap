# 网关路由模板（对应 K8s base/client/ingress.yaml 的路径分流逻辑）
# 运行时由 nginx 官方镜像 envsubst 替换 ${USER_SERVICE_URL} / ${TRAVEL_SERVICE_URL} / ${CLIENT_URL}
#
# 传输安全（HTTPS）：
# - TLS 与 http→https 跳转统一由边缘层完成（Azure Container Apps 外部入口
#   transport=Auto，或 K8s nginx Ingress），网关容器自身只监听 80（HTTP），
#   因此这里不做容器内 301 强制跳转，避免在边缘层未转发
#   X-Forwarded-Proto=https 时产生重定向循环。
# - 附加 HSTS 等安全响应头，让浏览器长期只走 HTTPS。
# - $host / $request_uri 是 nginx 内置变量，envsubst 不会替换它们。
server {
    listen 80;

    # 安全响应头：HSTS 要求浏览器后续只用 HTTPS；其余为常见 XSS/嗅探防护
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # More specific travel routes must precede the generic API route.
    location /api/travels/ {
        proxy_pass ${TRAVEL_SERVICE_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /api/* -> user-service (the /api prefix is preserved)
    location /api/ {
        proxy_pass ${USER_SERVICE_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 其余 → 前端 client（SPA，client 内部 nginx 处理 history fallback）
    location / {
        proxy_pass ${CLIENT_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
