{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=appdb;Username=appuser;Password=__SET_VIA_ENV__;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=100;Include Error Detail=true"
  },
  "Jwt": {
    "Issuer": "travel-map",
    "Audience": "travel-map-client"
  },
  // 服务身份（ADR-0022）：本服务在 identity-service 注册的 Client。
  // ClientId 是身份的一部分，随代码走；ClientSecret 只在这里放占位符，
  // 真实值由环境变量 ServiceIdentity__ClientSecret 注入（占位符会被拒绝启动）。
  "ServiceIdentity": {
    "Issuer": "http://identity-service:8080/identity",
    "ClientId": "user-service",
    "ClientSecret": "__SET_VIA_ENV__"
  },
  // 跨服务调用（ADR-0025）：user-service 以登录用户的名义（委托令牌）读 travel-service 的足迹概览。
  // Audience 必须与 travel-service 的 ServiceIdentity:ClientId 以及 identity 的
  // Identity:AllowedServiceAudiences 三处一致；BaseUrl 用 compose 的服务名（与 Identity:Issuer 同一约定）。
  "TravelService": {
    "Audience": "travel-service",
    "BaseUrl": "http://travel-server:8080"
  }
}
