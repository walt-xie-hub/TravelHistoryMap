{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Issuer": "http://localhost:8090/identity",
    "Audience": "travel-map-client",
    "ServiceId": "identity-service",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 7,
    // 允许作为服务令牌 aud 的目标（ADR-0022，默认拒绝）：新增跨服务调用时才加。
    "AllowedServiceAudiences": ["user-service", "travel-service", "identity-service"],
    // 部署期注册的服务客户端：secret 只放占位符，真实值由环境变量
    // Identity__ServiceClients__<下标>__ClientSecret 按同一顺序注入。
    // ⚠️ 这里的数组顺序是与 docker-compose.dev.yml / deploy-azure.sh 的约定，改动需同步。
    "ServiceClients": [
      {
        "ClientId": "user-service",
        "DisplayName": "user-service",
        "ClientSecret": "__SET_VIA_ENV__"
      },
      {
        "ClientId": "travel-service",
        "DisplayName": "travel-service",
        "ClientSecret": "__SET_VIA_ENV__"
      },
      {
        "ClientId": "identity-service",
        "DisplayName": "identity-service",
        "ClientSecret": "__SET_VIA_ENV__"
      }
    ],
    "Lockout": {
      "MaxFailedAttempts": 5,
      "WindowMinutes": 15,
      "LockoutMinutes": 15
    },
    "SigningKeyStore": {
      "Provider": "Development",
      "Path": "keys",
      "KeyVaultUri": "",
      "ActiveKid": ""
    }
  }
}
